# LLM 提供商配置
# 支持 Anthropic(Claude) / DeepSeek / Google(Gemini) / OpenAI 兼容（GLM/Qwen/SiliconFlow）
# Claude / DeepSeek / Gemini 使用官方 SDK，无需配 BASE_URL（SDK 自带默认地址）
# GLM / Qwen / SiliconFlow 代理走 OpenAI 兼容路径，必须配 LLM_BASE_URL
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/zai-org/GLM-4.7

# Vision LLM 配置（可选，对话含图片附件时自动切换）
# 若不配置则始终使用上方 LLM；API_KEY 和 BASE_URL 不填时复用 LLM 的配置
VISION_API_KEY=your-api-key-here
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4.6v

# Web Search（可选，配置后启用 Tavily 搜索）
TAVILY_API_KEY=

# 会话标题生成（可选，默认使用 DeepSeek-V3.2）
# 可以单独配置URL和KEY，若不配置则复用LLM的配置
TITLE_API_KEY=
TITLE_BASE_URL=
TITLE_MODEL=deepseek-ai/DeepSeek-V3.2

# SpreadJS License（必填）
# 运行时 LicenseKey
NEXT_PUBLIC_SPREADJS_LICENSE=your-spreadjs-license
# Designer LicenseKey
NEXT_PUBLIC_SPREADJS_DESIGNER_LICENSE=your-spreadjs-designer-license

# 业务数据（单据模板化填报系统，均可选）
# SQLite 数据库文件路径，默认 ./data/app.db
SJS_DB_PATH=./data/app.db
# 上传的单据图片落盘目录，默认 ./data/uploads
SJS_UPLOAD_DIR=./data/uploads
